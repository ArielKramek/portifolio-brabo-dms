<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= dados.perfil.nomeCompleto %> | Portfólio</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

  <style>
    body {
      font-family: Arial, sans-serif;
      scroll-behavior: smooth;
    }

    .hero-bg {
      background: linear-gradient(135deg, #0f172a 0%, #1e2937 100%);
    }

    .project-card {
      transition: all 0.3s ease;
    }

    .project-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3);
    }

    .skill-card {
      transition: all 0.3s ease;
    }

    .skill-card:hover {
      transform: scale(1.05);
      background-color: #10b981;
      color: black;
    }
  </style>
</head>

<body class="bg-zinc-950 text-white">

  <nav class="fixed top-0 w-full bg-zinc-900/95 backdrop-blur-md border-b border-zinc-800 z-50">
    <div class="max-w-6xl mx-auto px-6 py-5 flex justify-between items-center">
      <h1 class="text-2xl md:text-3xl font-bold">
        <%= dados.perfil.nomeCompleto %>
      </h1>

      <div class="hidden md:flex gap-8 text-lg">
        <a href="#sobre" class="hover:text-emerald-400 transition">Sobre</a>
        <a href="#certificados" class="hover:text-emerald-400 transition">Certificados</a>
        <a href="#habilidades" class="hover:text-emerald-400 transition">Habilidades</a>
        <a href="#contato" class="hover:text-emerald-400 transition">Contato</a>
      </div>

      <button id="menu-btn" class="md:hidden text-3xl">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </nav>

  <section class="hero-bg min-h-screen flex items-center justify-center text-center px-6 pt-20">
    <div>
      <img 
        src="https://picsum.photos/200"
        alt="<%= dados.perfil.nomeCompleto %>"
        class="w-40 h-40 rounded-full mx-auto mb-8 border-4 border-emerald-500 object-cover"
      >

      <h2 class="text-5xl md:text-7xl font-bold mb-6">
        <%= dados.perfil.nomeCompleto %>
      </h2>

      <p class="text-2xl md:text-3xl text-emerald-400 mb-6">
        <%= dados.perfil.curso %>
      </p>

      <p class="max-w-2xl mx-auto text-zinc-300 text-lg mb-10">
        📍 <%= dados.perfil.localizacao %>
      </p>

      <a href="#certificados"
         class="bg-emerald-500 hover:bg-emerald-600 transition px-10 py-4 rounded-full text-lg font-semibold">
        Ver Certificados
      </a>
    </div>
  </section>

  <section id="sobre" class="py-24 bg-zinc-900">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-bold text-center mb-12">
        Sobre Mim
      </h2>

      <div class="max-w-4xl mx-auto text-center">
        <p class="text-zinc-300 text-lg leading-relaxed mb-6">
          Sou estudante do curso de <strong><%= dados.perfil.curso %></strong>.
        </p>
        <p class="text-zinc-300 text-lg leading-relaxed">
          Atualmente residindo em <%= dados.perfil.localizacao %>, focado no aprendizado e desenvolvimento de soluções web.
        </p>
      </div>
    </div>
  </section>

  <section id="certificados" class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-bold text-center mb-14">
        Certificados & Cursos
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8">

        <% if (dados.certificados && dados.certificados.length > 0) { %>
          <% dados.certificados.forEach(cert => { %>
            <div class="project-card bg-zinc-900 rounded-3xl p-8 border border-zinc-800">
              <div class="text-5xl text-emerald-400 mb-6">
                <i class="fas fa-certificate"></i>
              </div>

              <h3 class="text-2xl font-semibold mb-2">
                <%= cert.nome %>
              </h3>

              <p class="text-emerald-400 text-sm mb-4">
                Emissão: <%= cert.dataEmissao %> • Carga Horária: <%= cert.duracao %>h
              </p>

              <p class="text-zinc-400 mb-6">
                <%= cert.descricao %>
              </p>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-center text-zinc-500 col-span-2">Nenhum certificado encontrado.</p>
        <% } %>

      </div>
    </div>
  </section>

  <section id="habilidades" class="py-24 bg-zinc-900">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl font-bold text-center mb-14">
        Habilidades
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 text-center">
        <div class="skill-card bg-zinc-800 p-6 rounded-2xl">HTML5</div>
        <div class="skill-card bg-zinc-800 p-6 rounded-2xl">CSS3</div>
        <div class="skill-card bg-zinc-800 p-6 rounded-2xl">JavaScript</div>
        <div class="skill-card bg-zinc-800 p-6 rounded-2xl">Tailwind CSS</div>
        <div class="skill-card bg-zinc-800 p-6 rounded-2xl">Node.js</div>
        <div class="skill-card bg-zinc-800 p-6 rounded-2xl">Express / EJS</div>
      </div>
    </div>
  </section>

  <section id="contato" class="py-24 text-center px-6">
    <h2 class="text-4xl font-bold mb-6">
      Contato
    </h2>

    <p class="text-zinc-400 text-lg mb-2">
      Entre em contato comigo:
    </p>

    <p class="text-emerald-400 text